<?xml version="1.0"?>
<ruleset name="UCF WordPress Block Theme">
	<description>WordPress coding standards for the UCF WordPress Block Theme.</description>

	<!-- Scan the whole theme by default; pass a path to phpcs to narrow it. -->
	<file>.</file>

	<!-- Only lint PHP. -->
	<arg name="extensions" value="php"/>

	<!-- Show sniff codes and a progress bar, and run in parallel. -->
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- Nothing generated, vendored, or non-PHP needs linting. -->
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>
	<exclude-pattern>/assets/</exclude-pattern>

	<!-- Target the versions the theme supports (style.css: 6.5+, PHP 8.1+). -->
	<config name="minimum_supported_wp_version" value="6.5"/>

	<!-- The full WordPress standard: Core, Docs, and Extra. -->
	<rule ref="WordPress"/>

	<!-- Enforce this theme's text domain on all translation calls. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ucf-wordpress-block-theme"/>
			</property>
		</properties>
	</rule>

	<!--
	Global functions/hooks must carry the theme prefix. `ucf` is deliberately short: this
	theme is the generic UCF block theme, and a child theme or companion plugin prefixes
	itself more specifically rather than nesting under a longer name here.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ucf_theme"/>
				<element value="UCF_THEME"/>
			</property>
		</properties>
	</rule>

	<!--
	The unit suite is PSR-4 autoloaded and follows PHPUnit's conventions, which are flatly
	incompatible with WordPress's file naming: PSR-4 requires the file to be named for the
	class (BlockStylesTest.php), while WordPress wants class-blockstylestest.php. Renaming
	would break autoloading, so the naming sniff is scoped off for the test directory only —
	everything shipped still obeys it.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/php/</exclude-pattern>
	</rule>

	<!--
	A PHPUnit method name is the assertion in words — test_returns_non_strings_untouched()
	needs no second sentence restating it. Descriptions are still written wherever a test pins
	behavior for a reason that is not obvious from its name, which is most of them.
	-->
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/php/</exclude-pattern>
	</rule>

	<!--
	ABSPATH is core's constant, not the theme's. The bootstrap defines it because every
	include guards on it, and it has to carry core's exact name to satisfy that guard.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>/tests/php/bootstrap\.php</exclude-pattern>
	</rule>

	<!--
	The stubs stand in for core functions and must carry core's exact names and signatures — a
	prefixed `ucf_theme__()` would stand in for nothing, and dropping the unused `$domain`
	parameter would stop the signature matching the function it replaces.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedFunctionFound">
		<exclude-pattern>/tests/php/stubs/</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>/tests/php/stubs/</exclude-pattern>
	</rule>

	<!--
	This sniff exists to stop a theme hand-printing a <script> tag instead of enqueueing it.
	UniversityHeaderTest builds those tags as fixtures — they are the *input* to the
	`script_loader_tag` filter under test — so it is reading strings the theme never emits.
	-->
	<rule ref="WordPress.WP.EnqueuedResources">
		<exclude-pattern>/tests/php/</exclude-pattern>
	</rule>
</ruleset>
