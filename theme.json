	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ucf-sans-serif-alt)",
			"lineHeight": "1.5"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "inherit",
					"fontWeight": "600",
					"lineHeight": "1.1"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "1rem"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary-aw)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"button": {
				"border": {
					"radius": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--secondary)"
				},
				"typography": {
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.03em"
				},
				"spacing": {
					"padding": {
						"top": "0.5rem",
						"bottom": "0.5rem",
						"left": "1rem",
						"right": "1rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--gold-darker)",
						"text": "var(--wp--preset--color--secondary)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--gold-darker)",
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--gray-dark)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)"
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	],
	"version": 3
}
