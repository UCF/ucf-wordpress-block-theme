	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--black)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"letterSpacing": "0.01em",
					"lineHeight": "1.1",
					"textTransform": "uppercase"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-1)",
					"fontWeight": "700",
					"lineHeight": "0.98"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-2)",
					"lineHeight": "1.04"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-3)",
					"lineHeight": "1.1"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"letterSpacing": "0",
					"textTransform": "none",
					"fontSize": "var(--wp--preset--font-size--heading-4)",
					"fontWeight": "800",
					"lineHeight": "1.3"
				}
			},
			"link": {
				"color": {
					"text": "var(--ucf-link, var(--wp--preset--color--horizon-deep))"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--ucf-link-hover, var(--wp--preset--color--horizon-deeper))"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"button": {
				"border": {
					"radius": "0"
				},
				"color": {
					"background": "var(--ucf-button, var(--wp--preset--color--gold))",
					"text": "var(--ucf-button-text, var(--wp--preset--color--black))"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--data-lg)",
					"fontWeight": "700",
					"letterSpacing": "0.01em",
					"lineHeight": "1.2",
					"textTransform": "none"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"right": "1.5rem",
						"bottom": "0.8rem",
						"left": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--ucf-button-hover, var(--wp--preset--color--black))",
						"text": "var(--ucf-button-hover-text, var(--wp--preset--color--gold))"
					}
				},
				":focus": {
					"color": {
						"background": "var(--ucf-button-hover, var(--wp--preset--color--black))",
						"text": "var(--ucf-button-hover-text, var(--wp--preset--color--gold))"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--ucf-muted, var(--wp--preset--color--gray-600))"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--data)",
					"lineHeight": "1.55"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"letterSpacing": "0",
					"textTransform": "none",
					"fontSize": "var(--wp--preset--font-size--heading-5)",
					"fontWeight": "700",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"letterSpacing": "0.01em",
					"textTransform": "none",
					"fontSize": "var(--wp--preset--font-size--heading-6)",
					"fontWeight": "700",
					"lineHeight": "1.4"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--data-lg)",
					"fontWeight": "600"
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--data-lg)"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing",
			"postTypes": [ "page" ]
		}
	]
}
